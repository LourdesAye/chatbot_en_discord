# PYTHONPATH: Python debe considerar src/ como lugar donde buscar módulos
PYTHONPATH=./src

# Base de datos relacional (usá un rol propio, no el superusuario)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Discord
DISCORD_TOKEN=
NOMBRE_CANAL_CHATBOT=
ID_CANAL_CHATBOT=

# Canales donde alumnos preguntan y docentes responden (aprendizaje en tiempo real). Opcional, separados por coma.
CANALES_DE_CONSULTAS_ALUMNOS=
ID_CANALES_DE_CONSULTAS_ALUMNOS=

# Telemetría de ChromaDB
ANONYMIZED_TELEMETRY=False

# Modelo de embeddings. Si lo cambiás, la base vectorial se reconstruye sola.
# Opciones: paraphrase-multilingual-MiniLM-L12-v2 (liviano), paraphrase-multilingual-mpnet-base-v2, BAAI/bge-m3 (pesado)
EMBEDDINGS_MODELO=BAAI/bge-m3

# RAG con modelo local (Ollama)
RAG_HABILITADO=false
OLLAMA_URL=http://localhost:11434
# Opciones: qwen2.5:1.5b (rápido), qwen2.5:3b, qwen2.5:7b (mejor calidad, más RAM)
OLLAMA_MODEL=qwen2.5:7b
# Tamaño de contexto y largo máximo de la respuesta: bajarlos ahorra memoria y tiempo
OLLAMA_NUM_CTX=4096
OLLAMA_MAX_TOKENS=350
# segundos máximos de espera de la respuesta del modelo (en una notebook sin GPU puede tardar)
OLLAMA_TIMEOUT=180
# Similitud mínima para usar una conversación como contexto (calibrar con comparar_modelos.py)
RAG_UMBRAL_SIMILITUD=0

# generativo: el modelo redacta y el código verifica | extractivo: sin modelo, frases textuales
RAG_MODO=generativo
# Proporción mínima (0 a 1) de palabras de cada oración que debe aparecer en el fragmento citado
RAG_MIN_APOYO=0.6
# Similitud mínima para mostrar frases de docentes cuando no hay respuesta directa (1 = nunca)
RAG_UMBRAL_SUGERENCIA=0.0
# ID del canal de consultas de la cátedra (Discord > Ajustes > Avanzado > Modo desarrollador > Copiar ID)
ID_CANAL_CONSULTAS_CATEDRA=

# Rutas
# Relativas: se cuentan desde la raíz del proyecto (donde está este archivo).
# Absolutas (C:/... o /home/...): se usan tal cual, útil para datos privados fuera del repo.
# Configuración (docentes y frases). Por defecto la de ejemplo, con datos inventados.
# Para usar la real, apuntá a una carpeta PRIVADA (idealmente fuera del repositorio).
CONFIG_DIR=config_ejemplo
LOG_DIR=logs
# Por defecto, los datos ficticios incluidos en el repo. Para datos propios, apuntá a otra carpeta.
JSON_DIR=datos_ejemplo
CHROMA_DIR=chroma

# Carga de datos
FILE_NAME=chat.json
MAX_DEPTH=4

# Logs
# Nivel mínimo que se escribe: DEBUG < INFO < WARNING < ERROR < CRITICAL
# Si no se define LOG_LEVEL (o el valor no es válido), se usa INFO.
LOG_LEVEL=INFO
# Opcional: nivel propio para un logger → LOG_LEVEL_<NOMBRE_EN_MAYUSCULAS>
# Tiene prioridad sobre LOG_LEVEL. Los demás archivos siguen usando LOG_LEVEL.
# Los nombres deben ir en MAYÚSCULAS y exactos: si uno está mal escrito, no se aplica
# y ese logger usa LOG_LEVEL.
#
# Nombres posibles y archivo de log que controlan:
#   CARGA_DB                   → log_persistencia_de_datos.txt
#   CARGA_PROCESADOR           → log_procesamiento_con_preguntas_cerradas.txt
#   PROCESAMIENTO_DE_MENSAJES  → logs_procesar_mensajes.txt
#   PROCESAMIENTO_TIEMPO_REAL  → log_procesamiento_tiempo_real.txt
#   LOGGER_EMBEDDINGS          → logs_generacion_embeddings.txt
#   LOGGER_EXTRAER_PREGUNTAS   → logs_preguntas_para_embeddings.txt
#   RAG_OLLAMA                 → log_rag_ollama.txt
#   MIGRACIONES_ALEMBIC        → log_migraciones_alembic_automaticas.txt
#   LOGGER_CARGADOR_YAML       → cargador_yaml.txt
#   CHATBOT_CON_DISCORD        → log_chatbot_integracion_discord.txt
#   DISCORD                    → log_discord_* (librería discord.py)
#
# Ejemplos (con LOG_LEVEL=INFO):
# Todos los archivos quedan en INFO y solo log_persistencia_de_datos.txt incluye DEBUG:
# LOG_LEVEL_CARGA_DB=DEBUG
# La librería discord.py solo registra avisos y errores:
# LOG_LEVEL_DISCORD=WARNING

